Windows Registry Editor Version 5.00

; Registers the J2534 proxy as a selectable VIM in Techstream.
; BEFORE importing: make sure FunctionLibrary below points to where you put
; j2534_proxy.dll. Default assumes C:\mvci-proxy\j2534_proxy.dll
; Import by double-clicking this file (approve the UAC/registry prompt).

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\PassThruSupport.04.04\MVCI Proxy]
"Name"="MVCI Proxy (Techstream Fix)"
"Vendor"="Community"
"FunctionLibrary"="C:\\mvci-proxy\\j2534_proxy.dll"
"ConfigApplication"=""
"APIVersion"="04.04"
"ProductVersion"="1.0.0"
"ProtocolsSupported"="J1850VPW:1, J1850PWM:1, CAN:1, ISO9141:1, ISO14230:1, ISO15765:1"
"J1850VPW"=dword:00000001
"J1850PWM"=dword:00000001
"ISO9141"=dword:00000001
"ISO14230"=dword:00000001
"CAN"=dword:00000001
"ISO15765"=dword:00000001
"SCI_A_ENGINE"=dword:00000000
"SCI_A_TRANS"=dword:00000000
"SCI_B_ENGINE"=dword:00000000
"SCI_B_TRANS"=dword:00000000
